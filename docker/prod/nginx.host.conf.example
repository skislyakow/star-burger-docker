# Пример host-nginx для star-burger.kislyakov.pro при Docker-деплое.
# SSL-блоки Certbot на сервере сохраняются как есть.
#
# proxy -> контейнер backend на 127.0.0.1:8002
# static/media -> bind-mount каталоги инфраструктурного репозитория

server {
    server_name star-burger.kislyakov.pro;

    client_max_body_size 20M;

    location /static/ {
        alias /opt/star-burger-docker/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /opt/star-burger-docker/media/;
        expires 30d;
    }

    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 120s;
    }

    # listen 443 ssl; и сертификаты — через Certbot
}
